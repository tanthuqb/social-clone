{
  "name": "suzu.net.turborepo",
  "private": true,
  "scripts": {
    "build": "turbo build",
    "dev": "turbo dev",
    "lint": "turbo lint",
    "check-types": "turbo check-types",
    "test:e2e": "turbo test:e2e",
    "format": "prettier --write \"**/*.{ts,tsx,md}\""
  },
  "devDependencies": {
    "@suzu/eslint-config": "workspace:*",
    "@suzu/typescript-config": "workspace:*",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "prettier": "^3.9.9",
    "turbo": "^2.11.3",
    "typescript": "6.0.3"
  },
  "packageManager": "pnpm@10.26.0",
  "engines": {
    "node": ">=20"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "@swc/core",
      "bcrypt",
      "bufferutil",
      "esbuild",
      "utf-8-validate"
    ]
  }
}
