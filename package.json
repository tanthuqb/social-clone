{
  "name": "suzu.net.turborepo",
  "private": true,
  "scripts": {
    "build": "turbo build ",
    "dev": "turbo dev  ",
    "lint": "turbo lint",
    "format": "prettier --write \"**/*.{ts,tsx,md}\""
  },
  "devDependencies": {
    "@suzu/eslint-config": "workspace:*",
    "@suzu/typescript-config": "workspace:*",
    "prettier": "^3.9.6",
    "turbo": "^2.10.8"
  },
  "packageManager": "pnpm@10.26.0",
  "engines": {
    "node": ">=20"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "@swc/core",
      "bcrypt",
      "bufferutil",
      "esbuild",
      "utf-8-validate"
    ]
  }
}