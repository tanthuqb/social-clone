# Copy to .env.local and fill in real values. Never commit .env.local.

# --- Supabase (required) ------------------------------------------------------
# Project URL. Keep the trailing slash.
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co/
# Anon / publishable key (safe for the browser; RLS protects the data).
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-or-publishable-key
# Used by `pnpm supabase:gentype` style tooling only.
SUPABASE_PROJECT_ID=your-project-ref

# --- App ----------------------------------------------------------------------
NEXT_PUBLIC_APP_NAME=SuZu
# Absolute site URL for metadata (Open Graph). Falls back to VERCEL_URL, then
# http://localhost:$PORT.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# --- Optional -----------------------------------------------------------------
# Google Analytics measurement id (scripts are only added when set).
GA_MEASUREMENT_ID=

# OAuth (Google / Facebook) credentials are configured in the Supabase
# dashboard (Authentication -> Providers), not in this app.

# --- End-to-end tests (Playwright) ------------------------------------------------
# A dedicated TEST account (email/password, already confirmed) used by the
# authenticated specs. When unset, those specs are skipped.
E2E_USER_EMAIL=
E2E_USER_PASSWORD=
# Optional: port / base URL for the Playwright web server (default 3104).
# PLAYWRIGHT_PORT=3104
# PLAYWRIGHT_BASE_URL=http://localhost:3104
